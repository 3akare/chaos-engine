{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "chaos-engine-game",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": true,
    "http": {
      "enable": false,
      "domains": []
    }
  },
  "scheduler": {
    "tasks": {
      "daily-tick": {
        "endpoint": "/internal/cron/tick",
        "cron": "*/10 * * * *"
      }
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade"
  },
  "menu": {
    "items": [
      {
        "label": "Chaos Engine: New post for today",
        "description": "Only if today's post was deleted: posts today's game again",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/new-post"
      },
      {
        "label": "Chaos Engine: Remove a score…",
        "description": "Take a player off today's leaderboard",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/remove-score"
      },
      {
        "label": "Chaos Engine: How hard is today?",
        "description": "What the generator's own search caught on today's machine",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/show-par"
      },
      {
        "label": "Chaos Engine: Show duplicates",
        "description": "Duplicate posts or comments to clean up",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/show-dupes"
      }
    ]
  },
  "forms": {
    "removeScore": "/internal/form/remove-score"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "chaos_engine_game_dev"
  }
}
